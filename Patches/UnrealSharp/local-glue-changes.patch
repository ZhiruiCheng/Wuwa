+    // Wuwa 本地改动：属性/参数引用的类型所在模块定义了 SkipGlueGeneration（如 LGUI）时，那个模块没有 C# 绑定，
+    // 生成的 C# 会找不到类型、整个构建失败。原版不检查这一点，这里把这类属性/参数跳过。
+    public static bool ReferencesSkippedPackage(this UhtProperty property)
+    {
+        static bool IsSkipped(UhtType? type) => type != null
+            && (!type.Package.ShouldExportPackage() || (type is UhtClass classType && classType.DerivesFromSkippedPackage()));
+
+        return property switch
+        {
+            UhtObjectPropertyBase objectProperty => IsSkipped(objectProperty.Class) || IsSkipped(objectProperty.MetaClass),
+            UhtStructProperty structProperty => IsSkipped(structProperty.ScriptStruct),
+            UhtEnumProperty enumProperty => IsSkipped(enumProperty.Enum),
+            UhtByteProperty byteProperty => IsSkipped(byteProperty.Enum),
+            UhtMapProperty mapProperty => mapProperty.KeyProperty.ReferencesSkippedPackage() || mapProperty.ValueProperty.ReferencesSkippedPackage(),
+            UhtContainerBaseProperty containerProperty => containerProperty.ValueProperty.ReferencesSkippedPackage(),
+            _ => false,
+        };
+    }
+
+    // Wuwa 本地改动：父类链上有类在 SkipGlueGeneration 模块里（比如继承 LGUI 的 UUIItem），这个类也不能生成 C#（父类没有绑定）。
+    public static bool DerivesFromSkippedPackage(this UhtClass classObj)
+    {
+        for (UhtClass? current = classObj.SuperClass; current != null; current = current.SuperClass)
+        {
+            if (!current.Package.ShouldExportPackage())
+            {
+                return true;
+            }
+        }
+        return false;
+    }
