diff --git a/Source/LGUI/LGUI.Build.cs b/Source/LGUI/LGUI.Build.cs
index 9cfe61f..cec2e77 100644
--- a/Source/LGUI/LGUI.Build.cs
+++ b/Source/LGUI/LGUI.Build.cs
@@ -6,6 +6,10 @@ public class LGUI : ModuleRules
 {
 	public LGUI(ReadOnlyTargetRules Target) : base(Target)
 	{
+		// Wuwa 本地改动：不让 UnrealSharp 给 LGUI 生成 C# 绑定（UIEventTriggerComponent 的委托属性和接口函数同名，生成的 C# 编译不过）。
+		// UnrealSharp 只读 UHT 清单里模块自己的 PublicDefines（不含依赖传递来的），所以必须用 PublicDefinitions；
+		// 依赖 LGUI 的模块（如 Wuwa）在清单里不会带上它，C# 绑定照常生成；C++ 里这个宏没人用。
+		PublicDefinitions.Add("SkipGlueGeneration=1");
         PCHUsage = ModuleRules.PCHUsageMode.UseExplicitOrSharedPCHs;
         bEnableUndefinedIdentifierWarnings = false;
         CppStandard = CppStandardVersion.Cpp20;
diff --git a/Source/LGUI/Private/Core/LGUIFontData_BaseObject.cpp b/Source/LGUI/Private/Core/LGUIFontData_BaseObject.cpp
index ee24bd0..d5b6c7d 100644
--- a/Source/LGUI/Private/Core/LGUIFontData_BaseObject.cpp
+++ b/Source/LGUI/Private/Core/LGUIFontData_BaseObject.cpp
@@ -1,4 +1,4 @@
-﻿// Copyright 2019-Present LexLiu. All Rights Reserved.
+// Copyright 2019-Present LexLiu. All Rights Reserved.
 
 #include "Core/LGUIFontData_BaseObject.h"
 #include "LGUI.h"
@@ -8,7 +8,17 @@
 
 ULGUIFontData_BaseObject* ULGUIFontData_BaseObject::GetDefaultFont()
 {
-	static auto defaultFont = LoadObject<ULGUIFontData_BaseObject>(NULL, TEXT("/LGUI/DefaultSDFFont"));
+	// Wuwa local patch: the cached raw pointer must keep the font alive. Without AddToRoot the font is garbage-collected
+	// once no UIText references it (e.g. after a map change), the static pointer dangles, and the next UIText crashes in GetTextureToCreateGeometry.
+	static ULGUIFontData_BaseObject* defaultFont = []()
+	{
+		ULGUIFontData_BaseObject* Loaded = LoadObject<ULGUIFontData_BaseObject>(NULL, TEXT("/LGUI/DefaultSDFFont"));
+		if (Loaded)
+		{
+			Loaded->AddToRoot();
+		}
+		return Loaded;
+	}();
 	if (defaultFont == nullptr)
 	{
 		auto errMsg = FText::Format(LOCTEXT("MissingDefaultContent", "{0} Load default font error! Missing some content of LGUI plugin, reinstall this plugin may fix the issue.")
